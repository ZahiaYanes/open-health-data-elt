python - <<'PY'
from pathlib import Path

gitignore = """\
# Python environment
.venv/
__pycache__/
*.py[cod]

# Data: never versioned, fully reproducible from the public source
data/raw/
data/landing/
warehouse/

# dbt artefacts
transform/target/
transform/dbt_packages/
transform/logs/
# Machine-specific anonymous user id generated by dbt
transform/.user.yml

# Note: transform/package-lock.yml IS versioned on purpose.
# It pins exact package versions and makes `dbt deps` reproducible.

# OS and editors
.DS_Store
.vscode/
.idea/
"""

Path(".gitignore").write_text(gitignore)
print(gitignore)
PY